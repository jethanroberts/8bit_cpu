module register #(
    parameter DATA_WIDTH = 8
) (
    // input
    input wire i_clk,
    input wire i_rst,
    input wire i_we,
    input wire i_bus_writable,
    // output
    output [DATA_WIDTH-1 : 0] o_data,
    // input and output
    inout [DATA_WIDTH-1 : 0] io_data
);

    reg [DATA_WIDTH-1:0] register;

    always @(posedge i_clk or posedge i_rst) begin
        if (i_rst) begin  
            register <= {DATA_WIDTH{1'b0}}; //resets all bits to 0
        end 
        else if (i_we) begin
            register <= io_data; //if write enabled, on posedge of clk reg = io_data
        end 
    end
assign o_data = register;
assign io_data = (i_bus_writable) ? register : {DATA_WIDTH{1'bz}}; //only drives bus when allowed
endmodule