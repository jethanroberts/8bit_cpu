module register #(
    parameter DATA_WIDTH = 8
) (
//inputs
input i_clk,
input i_rst,
input i_bus_writable,
input i_we,
//output
output [DATA_WIDTH-1:0] o_data,
//inout
inout [DATA_WIDTH-1:0] io_data
);

reg [DATA_WIDTH-1:0]register;

always @(posedge i_clk or posedge i_rst) begin
    if (i_rst) register <= 8'b0;
    else if (i_we) register <= io_data;
end

assign o_data = register;
assign io_data = (i_bus_writable) ? o_data : {DATA_WIDTH{1'bz}};

endmodule